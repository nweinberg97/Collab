# Collab runs fully in demo mode with no configuration.
# To enable real Spotify sign-in, create an app at https://developer.spotify.com/dashboard
# and copy this file to .env.

# Client ID of your Spotify app (PKCE flow — no client secret is needed or used).
COLLAB_SPOTIFY_CLIENT_ID=

# Must exactly match a Redirect URI registered on your Spotify app.
# Defaults to the page's own URL when left empty, e.g. http://127.0.0.1:5173/
COLLAB_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/

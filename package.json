{
  "name": "collab",
  "version": "0.1.0",
  "private": true,
  "description": "Collab — a private network where verified artists discover who they should make music with. A Spotify concept prototype.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --serve",
    "build": "node scripts/build.mjs",
    "build:single": "node scripts/build.mjs --single",
    "preview": "node scripts/build.mjs --serve --no-watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx scripts/test-recommendations.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
